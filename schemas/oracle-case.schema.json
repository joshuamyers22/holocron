{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joshuamyers22/holocron/schemas/oracle-case.schema.json",
  "title": "Holocron oracle case",
  "description": "A versioned, data-only request for the isolated R parity oracle.",
  "type": "object",
  "properties": {
    "schema_version": {"const": "holocron-oracle-case/v1"},
    "case_id": {"$ref": "#/$defs/identifier"},
    "description": {"type": "string", "minLength": 1},
    "expected_output": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*\\.json$"
    },
    "comparison_profile": {"$ref": "#/$defs/identifier"},
    "qualification_stage": {
      "enum": ["environment", "python-parity", "oracle-baseline"]
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "description",
    "expected_output",
    "comparison_profile",
    "qualification_stage"
  ],
  "oneOf": [
    {
      "title": "Oracle environment health case",
      "properties": {
        "operation": {"const": "health"},
        "qualification_stage": {"const": "environment"}
      },
      "required": ["operation"]
    },
    {
      "title": "Restricted cubic spline design case",
      "properties": {
        "operation": {"const": "rcs"},
        "qualification_stage": {"const": "python-parity"},
        "x": {"$ref": "#/$defs/nonemptyNumericVector"},
        "knots": {"$ref": "#/$defs/knotVector"}
      },
      "required": ["operation", "x", "knots"]
    },
    {
      "title": "OLS with restricted cubic splines case",
      "properties": {
        "operation": {"const": "ols_rcs"},
        "qualification_stage": {"const": "python-parity"},
        "x": {"$ref": "#/$defs/fitNumericVector"},
        "y": {"$ref": "#/$defs/fitNumericVector"},
        "knots": {"$ref": "#/$defs/knotVector"}
      },
      "required": ["operation", "x", "y", "knots"]
    },
    {
      "title": "Predictor data-distribution case",
      "properties": {
        "operation": {"const": "datadist"},
        "qualification_stage": {"const": "python-parity"},
        "variables": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/distributionVariable"}
        },
        "effect_quantiles": {"$ref": "#/$defs/quantilePair"},
        "display_quantiles": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/quantilePair"}
          ]
        },
        "categorical_adjustment": {"enum": ["mode", "first"]},
        "discrete_threshold": {"type": "integer", "minimum": 1}
      },
      "required": [
        "operation",
        "variables",
        "effect_quantiles",
        "display_quantiles",
        "categorical_adjustment",
        "discrete_threshold"
      ]
    },
    {
      "title": "Core numeric formula design case",
      "properties": {
        "operation": {"const": "design"},
        "qualification_stage": {"const": "python-parity"},
        "formula": {"type": "string", "minLength": 1, "maxLength": 4096},
        "response": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "maxLength": 256}
          ]
        },
        "include_intercept": {"type": "boolean"},
        "variables": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/designVariable"}
        },
        "terms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/designTerm"}
        }
      },
      "required": [
        "operation",
        "formula",
        "response",
        "include_intercept",
        "variables",
        "terms"
      ]
    },
    {
      "title": "Binary logistic regression case",
      "properties": {
        "operation": {"const": "lrm"},
        "qualification_stage": {"const": "python-parity"},
        "basis": {"$ref": "#/$defs/modelBasis"},
        "x": {"$ref": "#/$defs/fitNumericVector"},
        "y": {"$ref": "#/$defs/binaryVector"},
        "knots": {"$ref": "#/$defs/knotVector"}
      },
      "required": ["operation", "basis", "x", "y"]
    },
    {
      "title": "Generalized linear model case",
      "properties": {
        "operation": {"const": "glm"},
        "qualification_stage": {"const": "python-parity"},
        "basis": {"$ref": "#/$defs/modelBasis"},
        "family": {"enum": ["gaussian", "binomial"]},
        "link": {"enum": ["identity", "logit"]},
        "x": {"$ref": "#/$defs/fitNumericVector"},
        "y": {"$ref": "#/$defs/fitNumericVector"},
        "knots": {"$ref": "#/$defs/knotVector"}
      },
      "required": ["operation", "basis", "family", "link", "x", "y"],
      "allOf": [
        {
          "if": {"properties": {"family": {"const": "binomial"}}},
          "then": {
            "properties": {"link": {"const": "logit"}, "y": {"$ref": "#/$defs/binaryVector"}}
          },
          "else": {"properties": {"link": {"const": "identity"}}}
        }
      ]
    },
    {
      "title": "Core model post-estimation operations case",
      "properties": {
        "operation": {"const": "model_operations"},
        "qualification_stage": {"const": "python-parity"},
        "estimator": {"enum": ["ols", "glm-binomial", "lrm-binary"]},
        "x": {"$ref": "#/$defs/fitNumericVector"},
        "y": {"$ref": "#/$defs/fitNumericVector"},
        "evaluation_x": {"$ref": "#/$defs/nonemptyNumericVector"},
        "contrast_weights": {
          "const": [0, 1]
        },
        "confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}
      },
      "required": ["operation", "estimator", "x", "y", "evaluation_x", "contrast_weights", "confidence_level"],
      "allOf": [
        {
          "if": {"properties": {"estimator": {"enum": ["glm-binomial", "lrm-binary"]}}},
          "then": {"properties": {"y": {"$ref": "#/$defs/binaryVector"}}}
        }
      ]
    },
    {
      "title": "Penalty and alternative covariance case",
      "properties": {
        "operation": {"const": "regularization_covariance"},
        "qualification_stage": {"const": "python-parity"},
        "estimator": {"enum": ["ols", "glm-binomial", "lrm-binary"]},
        "x": {"$ref": "#/$defs/fitNumericVector"},
        "y": {"$ref": "#/$defs/fitNumericVector"},
        "penalty_weights": {
          "oneOf": [
            {"type": "null"},
            {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "number", "minimum": 0}}
          ]
        },
        "clusters": {"type": "array", "minItems": 3, "maxItems": 1000000, "items": {"type": "integer"}},
        "bootstrap_seed": {"type": "integer", "minimum": 0},
        "resample_indices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 10000,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 1000000,
            "items": {"type": "integer", "minimum": 0}
          }
        }
      },
      "required": ["operation", "estimator", "x", "y", "penalty_weights", "clusters", "bootstrap_seed", "resample_indices"],
      "allOf": [
        {
          "if": {"properties": {"estimator": {"enum": ["glm-binomial", "lrm-binary"]}}},
          "then": {"properties": {"y": {"$ref": "#/$defs/binaryVector"}}}
        },
        {
          "if": {"properties": {"estimator": {"const": "glm-binomial"}}},
          "then": {"properties": {"penalty_weights": {"type": "null"}}},
          "else": {"properties": {"penalty_weights": {"type": "array", "minItems": 1}}}
        }
      ]
    },
    {
      "title": "Ordinal regression case",
      "properties": {
        "operation": {"const": "orm"},
        "qualification_stage": {"const": "python-parity"},
        "basis": {"$ref": "#/$defs/modelBasis"},
        "family": {"enum": ["logistic", "probit", "loglog", "cloglog", "cauchit"]},
        "x": {"$ref": "#/$defs/fitNumericVector"},
        "y": {"$ref": "#/$defs/fitNumericVector"},
        "knots": {"$ref": "#/$defs/knotVector"}
      },
      "required": ["operation", "basis", "family", "x", "y"]
    },
    {
      "title": "Censored ordinal regression case",
      "properties": {
        "operation": {"const": "orm_censored"},
        "qualification_stage": {"const": "python-parity"},
        "basis": {"const": "linear"},
        "family": {"enum": ["logistic", "probit", "loglog", "cloglog", "cauchit"]},
        "x": {"$ref": "#/$defs/fitNumericVector"},
        "lower": {"$ref": "#/$defs/lowerCensorVector"},
        "upper": {"$ref": "#/$defs/upperCensorVector"}
      },
      "required": ["operation", "basis", "family", "x", "lower", "upper"]
    },
    {
      "title": "Clustered ordinal regression case",
      "properties": {
        "operation": {"const": "orm_random"},
        "qualification_stage": {"const": "python-parity"},
        "basis": {"const": "linear"},
        "family": {"enum": ["logistic", "probit", "loglog", "cloglog", "cauchit"]},
        "x": {"$ref": "#/$defs/fitNumericVector"},
        "y": {"$ref": "#/$defs/fitNumericVector"},
        "clusters": {"type": "array", "minItems": 4, "items": {"type": "integer"}},
        "mix_re": {
          "oneOf": [
            {"type": "null"},
            {"type": "array", "minItems": 4, "items": {"type": "number"}}
          ]
        },
        "quadrature_grid": {
          "type": "array", "minItems": 2, "uniqueItems": true,
          "items": {"type": "integer", "minimum": 3, "maximum": 127}
        },
        "quadrature_tolerance": {"type": "number", "exclusiveMinimum": 0}
      },
      "required": ["operation", "basis", "family", "x", "y", "clusters", "mix_re", "quadrature_grid", "quadrature_tolerance"]
    },
    {
      "title": "Cox proportional hazards case",
      "properties": {
        "operation": {"const": "cph"},
        "qualification_stage": {"const": "python-parity"},
        "basis": {"$ref": "#/$defs/modelBasis"},
        "method": {"enum": ["efron", "breslow"]},
        "x": {"$ref": "#/$defs/fitNumericVector"},
        "time": {"$ref": "#/$defs/positiveNumericVector"},
        "event": {"$ref": "#/$defs/binaryVector"},
        "knots": {"$ref": "#/$defs/knotVector"},
        "evaluation_x": {"$ref": "#/$defs/nonemptyNumericVector"},
        "evaluation_times": {"$ref": "#/$defs/positiveNumericVector"}
      },
      "required": ["operation", "basis", "method", "x", "time", "event", "evaluation_x", "evaluation_times"]
    },
    {
      "title": "Parametric survival case",
      "properties": {
        "operation": {"const": "psm"},
        "qualification_stage": {"const": "python-parity"},
        "basis": {"$ref": "#/$defs/modelBasis"},
        "distribution": {"enum": ["weibull", "exponential"]},
        "x": {"$ref": "#/$defs/fitNumericVector"},
        "time": {"$ref": "#/$defs/positiveNumericVector"},
        "event": {"$ref": "#/$defs/binaryVector"},
        "knots": {"$ref": "#/$defs/knotVector"},
        "evaluation_x": {"$ref": "#/$defs/nonemptyNumericVector"},
        "evaluation_times": {"$ref": "#/$defs/positiveNumericVector"}
      },
      "required": ["operation", "basis", "distribution", "x", "time", "event", "evaluation_x", "evaluation_times"]
    },
    {
      "title": "Nonparametric survival case",
      "properties": {
        "operation": {"const": "npsurv"},
        "qualification_stage": {"const": "python-parity"},
        "estimator": {"const": "kaplan-meier"},
        "time": {"$ref": "#/$defs/positiveNumericVector"},
        "event": {"$ref": "#/$defs/binaryVector"}
      },
      "required": ["operation", "estimator", "time", "event"]
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*-v[0-9]+$|^[a-z0-9][a-z0-9-]*$"
    },
    "nonemptyNumericVector": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "number"}
    },
    "fitNumericVector": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "number"}
    },
    "positiveNumericVector": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "number", "exclusiveMinimum": 0}
    },
    "binaryVector": {
      "type": "array",
      "minItems": 3,
      "items": {"enum": [0, 1]},
      "allOf": [
        {"contains": {"const": 0}},
        {"contains": {"const": 1}}
      ]
    },
    "lowerCensorVector": {
      "type": "array",
      "minItems": 3,
      "items": {"oneOf": [{"type": "number"}, {"const": "neg_inf"}]}
    },
    "upperCensorVector": {
      "type": "array",
      "minItems": 3,
      "items": {"oneOf": [{"type": "number"}, {"const": "pos_inf"}]}
    },
    "modelBasis": {"enum": ["linear", "rcs"]},
    "knotVector": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "number"}
    },
    "quantilePair": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "distributionValue": {
      "oneOf": [
        {"type": "number"},
        {"type": "string", "minLength": 1}
      ]
    },
    "distributionVariable": {
      "type": "object",
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["numeric", "categorical", "ordered"]},
        "values": {
          "type": "array",
          "minItems": 2,
          "items": {
            "oneOf": [
              {"$ref": "#/$defs/distributionValue"},
              {"type": "null"}
            ]
          }
        },
        "levels": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/distributionValue"}
        },
        "label": {"type": "string", "minLength": 1},
        "unit": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1}
          ]
        }
      },
      "required": ["name", "kind", "values", "label", "unit"],
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "numeric"}}},
          "then": {
            "properties": {
              "values": {
                "items": {
                  "oneOf": [
                    {"type": "number"},
                    {"type": "null"}
                  ]
                }
              }
            },
            "not": {"required": ["levels"]}
          },
          "else": {"required": ["levels"]}
        }
      ],
      "additionalProperties": false
    },
    "designVariable": {
      "type": "object",
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {"type": "number"},
              {"type": "string", "minLength": 1}
            ]
          }
        }
      },
      "required": ["name", "values"],
      "additionalProperties": false
    },
    "designMainEffect": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {"const": "identity"},
            "variable": {"type": "string", "minLength": 1, "maxLength": 256}
          },
          "required": ["kind", "variable"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {"const": "polynomial"},
            "variable": {"type": "string", "minLength": 1, "maxLength": 256},
            "degree": {"type": "integer", "minimum": 2, "maximum": 10}
          },
          "required": ["kind", "variable", "degree"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {"const": "linear_spline"},
            "variable": {"type": "string", "minLength": 1, "maxLength": 256},
            "knots": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {"type": "number"}
            }
          },
          "required": ["kind", "variable", "knots"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {"const": "restricted_cubic_spline"},
            "variable": {"type": "string", "minLength": 1, "maxLength": 256},
            "knots": {
              "type": "array",
              "minItems": 3,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {"type": "number"}
            }
          },
          "required": ["kind", "variable", "knots"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {"const": "categorical"},
            "variable": {"type": "string", "minLength": 1, "maxLength": 256},
            "levels": {
              "type": "array",
              "minItems": 2,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "oneOf": [
                  {"type": "number"},
                  {"type": "string", "minLength": 1}
                ]
              }
            },
            "unknown_level": {"const": "error"}
          },
          "required": ["kind", "variable", "levels", "unknown_level"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {"const": "ordered"},
            "variable": {"type": "string", "minLength": 1, "maxLength": 256},
            "levels": {
              "type": "array",
              "minItems": 3,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {"type": "number"}
            },
            "unknown_level": {"const": "error"}
          },
          "required": ["kind", "variable", "levels", "unknown_level"],
          "additionalProperties": false
        }
      ]
    },
    "designTerm": {
      "oneOf": [
        {"$ref": "#/$defs/designMainEffect"},
        {
          "type": "object",
          "properties": {
            "kind": {"const": "restricted_interaction"},
            "left": {"$ref": "#/$defs/designMainEffect"},
            "right": {"$ref": "#/$defs/designMainEffect"}
          },
          "required": ["kind", "left", "right"],
          "additionalProperties": false
        }
      ]
    }
  }
}
