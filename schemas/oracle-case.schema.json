{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joshuamyers22/holocron/schemas/oracle-case.schema.json",
  "title": "Holocron oracle case",
  "description": "A versioned, data-only request for the isolated R parity oracle.",
  "type": "object",
  "properties": {
    "schema_version": {"const": "holocron-oracle-case/v1"},
    "case_id": {"$ref": "#/$defs/identifier"},
    "description": {"type": "string", "minLength": 1},
    "expected_output": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*\\.json$"
    },
    "comparison_profile": {"$ref": "#/$defs/identifier"}
  },
  "required": [
    "schema_version",
    "case_id",
    "description",
    "expected_output",
    "comparison_profile"
  ],
  "oneOf": [
    {
      "title": "Oracle environment health case",
      "properties": {"operation": {"const": "health"}},
      "required": ["operation"]
    },
    {
      "title": "Restricted cubic spline design case",
      "properties": {
        "operation": {"const": "rcs"},
        "x": {"$ref": "#/$defs/nonemptyNumericVector"},
        "knots": {"$ref": "#/$defs/knotVector"}
      },
      "required": ["operation", "x", "knots"]
    },
    {
      "title": "OLS with restricted cubic splines case",
      "properties": {
        "operation": {"const": "ols_rcs"},
        "x": {"$ref": "#/$defs/fitNumericVector"},
        "y": {"$ref": "#/$defs/fitNumericVector"},
        "knots": {"$ref": "#/$defs/knotVector"}
      },
      "required": ["operation", "x", "y", "knots"]
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*-v[0-9]+$|^[a-z0-9][a-z0-9-]*$"
    },
    "nonemptyNumericVector": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "number"}
    },
    "fitNumericVector": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "number"}
    },
    "knotVector": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "number"}
    }
  }
}
