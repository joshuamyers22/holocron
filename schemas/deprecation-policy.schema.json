{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joshuamyers22/holocron/schemas/deprecation-policy.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {"const": "holocron-deprecation-policy/v1"},
    "package_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:[A-Za-z0-9.+-]*)?$"},
    "policy": {
      "type": "object",
      "properties": {
        "minimum_minor_releases": {"type": "integer", "minimum": 2},
        "minimum_days": {"type": "integer", "minimum": 90},
        "runtime_warning_required": {"const": true},
        "changelog_required": {"const": true},
        "migration_replacement_required": {"const": true},
        "pre_1_0_rule": {"type": "string", "minLength": 80}
      },
      "required": ["minimum_minor_releases", "minimum_days", "runtime_warning_required", "changelog_required", "migration_replacement_required", "pre_1_0_rule"],
      "additionalProperties": false
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "api": {"type": "string", "pattern": "^holocron(?:\\.[A-Za-z_][A-Za-z0-9_]*)+$"},
          "deprecated_in": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:[A-Za-z0-9.+-]*)?$"},
          "removal_not_before_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:[A-Za-z0-9.+-]*)?$"},
          "deprecated_on": {"type": "string", "format": "date"},
          "removal_not_before_date": {"type": "string", "format": "date"},
          "replacement": {"type": "string", "pattern": "^holocron(?:\\.[A-Za-z_][A-Za-z0-9_]*)+$"},
          "rationale": {"type": "string", "minLength": 40},
          "status": {"enum": ["active", "removed"]}
        },
        "required": ["api", "deprecated_in", "removal_not_before_version", "deprecated_on", "removal_not_before_date", "replacement", "rationale", "status"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "package_version", "policy", "notices"],
  "additionalProperties": false
}
