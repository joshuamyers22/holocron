{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joshuamyers22/holocron/schemas/data-distribution.schema.json",
  "title": "Holocron data-distribution metadata",
  "description": "A versioned immutable summary of predictor distributions and adjustment values.",
  "type": "object",
  "properties": {
    "schema_version": {"const": "holocron-data-distribution/v1"},
    "observation_count": {"type": "integer", "minimum": 1},
    "effect_quantiles": {"$ref": "#/$defs/quantilePair"},
    "display_quantiles": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/quantilePair"}
      ]
    },
    "categorical_adjustment": {"enum": ["mode", "first"]},
    "discrete_threshold": {"type": "integer", "minimum": 1},
    "variables": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/variable"}
    }
  },
  "required": [
    "schema_version",
    "observation_count",
    "effect_quantiles",
    "display_quantiles",
    "categorical_adjustment",
    "discrete_threshold",
    "variables"
  ],
  "additionalProperties": false,
  "$defs": {
    "value": {
      "oneOf": [
        {"type": "number"},
        {"type": "string", "minLength": 1}
      ]
    },
    "range": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/value"}
    },
    "quantilePair": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "variable": {
      "type": "object",
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["continuous", "discrete", "categorical", "ordered"]},
        "adjustment": {"$ref": "#/$defs/value"},
        "effect_range": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/range"}
          ]
        },
        "display_range": {"$ref": "#/$defs/range"},
        "overall_range": {"$ref": "#/$defs/range"},
        "values": {
          "type": "array",
          "items": {"$ref": "#/$defs/value"},
          "uniqueItems": true
        },
        "label": {"type": "string", "minLength": 1},
        "unit": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1}
          ]
        },
        "nonmissing_count": {"type": "integer", "minimum": 1},
        "missing_count": {"type": "integer", "minimum": 0}
      },
      "required": [
        "name",
        "kind",
        "adjustment",
        "effect_range",
        "display_range",
        "overall_range",
        "values",
        "label",
        "unit",
        "nonmissing_count",
        "missing_count"
      ],
      "additionalProperties": false
    }
  }
}
