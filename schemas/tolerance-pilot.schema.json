{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joshuamyers22/holocron/schemas/tolerance-pilot.schema.json",
  "title": "Holocron cross-platform tolerance pilot report",
  "type": "object",
  "properties": {
    "schema_version": {"const": "holocron-tolerance-pilot/v1"},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_is_dirty": {"type": "boolean"},
    "environment": {"$ref": "#/$defs/environment"},
    "oracle": {"$ref": "#/$defs/oracle"},
    "policy": {"$ref": "#/$defs/policy"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/caseResult"}
    },
    "summary": {"$ref": "#/$defs/summary"}
  },
  "required": [
    "schema_version",
    "generated_at_utc",
    "source_revision",
    "source_is_dirty",
    "environment",
    "oracle",
    "policy",
    "cases",
    "summary"
  ],
  "additionalProperties": false,
  "$defs": {
    "environment": {
      "type": "object",
      "properties": {
        "operating_system": {"type": "string", "minLength": 1},
        "operating_system_release": {"type": "string", "minLength": 1},
        "machine": {"type": "string", "minLength": 1},
        "python_implementation": {"type": "string", "minLength": 1},
        "python_version": {"type": "string", "minLength": 1},
        "numpy_version": {"type": "string", "minLength": 1},
        "blas": {"type": "string", "minLength": 1},
        "lapack": {"type": "string", "minLength": 1}
      },
      "required": [
        "operating_system",
        "operating_system_release",
        "machine",
        "python_implementation",
        "python_version",
        "numpy_version",
        "blas",
        "lapack"
      ],
      "additionalProperties": false
    },
    "oracle": {
      "type": "object",
      "properties": {
        "package": {"const": "rms"},
        "version": {"const": "8.2-0"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "protocol_version": {"const": "1"}
      },
      "required": ["package", "version", "commit", "protocol_version"],
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "path": {"const": "reference/tolerances.json"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "accepted_profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["data-distribution-v1", "deterministic-transform-v1", "well-conditioned-ols-v1"]}
        }
      },
      "required": ["path", "sha256", "accepted_profiles"],
      "additionalProperties": false
    },
    "caseResult": {
      "type": "object",
      "properties": {
        "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "profile": {"type": "string", "minLength": 1},
        "outcome": {"enum": ["passed", "failed"]},
        "exact_comparisons": {"type": "integer", "minimum": 0},
        "numeric_comparisons": {"type": "integer", "minimum": 0},
        "maximum_absolute_error": {"type": "number", "minimum": 0},
        "maximum_relative_error": {"type": "number", "minimum": 0},
        "mismatches": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "required": [
        "case_id",
        "profile",
        "outcome",
        "exact_comparisons",
        "numeric_comparisons",
        "maximum_absolute_error",
        "maximum_relative_error",
        "mismatches"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "outcome": {"enum": ["passed", "failed"]},
        "case_count": {"type": "integer", "minimum": 1},
        "failed_case_count": {"type": "integer", "minimum": 0},
        "maximum_absolute_error": {"type": "number", "minimum": 0},
        "maximum_relative_error": {"type": "number", "minimum": 0}
      },
      "required": ["outcome", "case_count", "failed_case_count", "maximum_absolute_error", "maximum_relative_error"],
      "additionalProperties": false
    }
  }
}
