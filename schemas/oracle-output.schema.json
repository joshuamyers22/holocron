{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joshuamyers22/holocron/schemas/oracle-output.schema.json",
  "title": "Holocron committed oracle output",
  "description": "A versioned expected response from the pinned R rms oracle.",
  "type": "object",
  "properties": {
    "schema_version": {"const": "holocron-oracle-output/v1"},
    "case_id": {"$ref": "#/$defs/identifier"},
    "reference": {"$ref": "#/$defs/reference"}
  },
  "required": ["schema_version", "case_id", "reference"],
  "oneOf": [
    {
      "title": "Oracle environment health output",
      "properties": {
        "oracle_image": {"type": "string", "minLength": 1},
        "oracle_image_digest": {"$ref": "#/$defs/sha256"},
        "rms_commit": {"$ref": "#/$defs/gitCommit"},
        "rms_file_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "rms_description_sha256": {"$ref": "#/$defs/sha256"},
        "hmisc_commit": {"$ref": "#/$defs/gitCommit"},
        "response": {"$ref": "#/$defs/healthResponse"}
      },
      "required": [
        "oracle_image",
        "oracle_image_digest",
        "rms_commit",
        "rms_file_manifest_sha256",
        "rms_description_sha256",
        "hmisc_commit",
        "response"
      ]
    },
    {
      "title": "Restricted cubic spline design output",
      "properties": {
        "ok": {"const": true},
        "protocol_version": {"const": "1"},
        "operation": {"const": "rcs"},
        "x": {"$ref": "#/$defs/numericVector"},
        "knots": {"$ref": "#/$defs/numericVector"},
        "nonlinear_mask": {
          "type": "array",
          "items": {"type": "boolean"}
        },
        "nonlinear_columns": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0}
        },
        "column_names": {"$ref": "#/$defs/nameVector"},
        "basis": {"$ref": "#/$defs/numericMatrix"}
      },
      "required": [
        "ok",
        "protocol_version",
        "operation",
        "x",
        "knots",
        "nonlinear_mask",
        "nonlinear_columns",
        "column_names",
        "basis"
      ]
    },
    {
      "title": "OLS with restricted cubic splines output",
      "properties": {
        "ok": {"const": true},
        "protocol_version": {"const": "1"},
        "operation": {"const": "ols_rcs"},
        "knots": {"$ref": "#/$defs/numericVector"},
        "coefficient_names": {"$ref": "#/$defs/nameVector"},
        "coefficients": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "number"}
        },
        "covariance_names": {"$ref": "#/$defs/nameVector"},
        "covariance": {"$ref": "#/$defs/numericMatrix"},
        "design_names": {"$ref": "#/$defs/nameVector"},
        "design": {"$ref": "#/$defs/numericMatrix"},
        "fitted": {"$ref": "#/$defs/numericVector"},
        "residuals": {"$ref": "#/$defs/numericVector"},
        "degrees_of_freedom": {"type": "integer", "minimum": 1},
        "sigma": {"type": "number", "exclusiveMinimum": 0}
      },
      "required": [
        "ok",
        "protocol_version",
        "operation",
        "knots",
        "coefficient_names",
        "coefficients",
        "covariance_names",
        "covariance",
        "design_names",
        "design",
        "fitted",
        "residuals",
        "degrees_of_freedom",
        "sigma"
      ]
    },
    {
      "title": "Predictor data-distribution output",
      "properties": {
        "ok": {"const": true},
        "protocol_version": {"const": "1"},
        "operation": {"const": "datadist"},
        "observation_count": {"type": "integer", "minimum": 2},
        "effect_quantiles": {"$ref": "#/$defs/quantilePair"},
        "display_quantiles": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/quantilePair"}
          ]
        },
        "categorical_adjustment": {"enum": ["mode", "first"]},
        "discrete_threshold": {"type": "integer", "minimum": 1},
        "variables": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/distributionVariable"}
        }
      },
      "required": [
        "ok",
        "protocol_version",
        "operation",
        "observation_count",
        "effect_quantiles",
        "display_quantiles",
        "categorical_adjustment",
        "discrete_threshold",
        "variables"
      ]
    },
    {
      "title": "Core numeric formula design output",
      "properties": {
        "ok": {"const": true},
        "protocol_version": {"const": "1"},
        "operation": {"const": "design"},
        "formula": {"type": "string", "minLength": 1, "maxLength": 4096},
        "response": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "maxLength": 256}
          ]
        },
        "include_intercept": {"type": "boolean"},
        "terms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/designTerm"}
        },
        "column_names": {"$ref": "#/$defs/nameVector"},
        "nonlinear_mask": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "boolean"}
        },
        "term_slices": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/termSlice"}
        },
        "design": {"$ref": "#/$defs/numericMatrix"}
      },
      "required": [
        "ok",
        "protocol_version",
        "operation",
        "formula",
        "response",
        "include_intercept",
        "terms",
        "column_names",
        "nonlinear_mask",
        "term_slices",
        "design"
      ]
    },
    {
      "title": "Binary logistic regression output",
      "allOf": [
        {"$ref": "#/$defs/modelFitOutput"},
        {
          "properties": {
            "operation": {"const": "lrm"},
            "response": {"$ref": "#/$defs/integerVector"},
            "fitted_probability": {"$ref": "#/$defs/numericVector"}
          },
          "required": ["operation", "response", "fitted_probability"]
        }
      ]
    },
    {
      "title": "Generalized linear model output",
      "allOf": [
        {"$ref": "#/$defs/modelFitOutput"},
        {
          "properties": {
            "operation": {"const": "glm"},
            "family": {"enum": ["gaussian", "binomial"]},
            "link": {"enum": ["identity", "logit"]},
            "response": {"$ref": "#/$defs/numericVector"},
            "fitted_mean": {"$ref": "#/$defs/numericVector"}
          },
          "required": ["operation", "family", "link", "response", "fitted_mean"]
        }
      ]
    },
    {
      "title": "Core model post-estimation operations output",
      "properties": {
        "ok": {"const": true},
        "protocol_version": {"const": "1"},
        "operation": {"const": "model_operations"},
        "estimator": {"enum": ["ols", "glm-binomial", "lrm-binary"]},
        "evaluation_x": {"$ref": "#/$defs/numericVector"},
        "contrast_weights": {"$ref": "#/$defs/numericVector"},
        "confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "coefficient_names": {"$ref": "#/$defs/nameVector"},
        "covariance": {"$ref": "#/$defs/numericMatrix"},
        "likelihood": {"$ref": "#/$defs/likelihoodResult"},
        "residuals": {"$ref": "#/$defs/residualResult"},
        "prediction": {"$ref": "#/$defs/predictionResult"},
        "summary": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/inferenceEstimate"}
        },
        "anova": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/anovaTest"}
        },
        "contrast": {"$ref": "#/$defs/inferenceEstimate"}
      },
      "required": ["ok", "protocol_version", "operation", "estimator", "evaluation_x", "contrast_weights", "confidence_level", "coefficient_names", "covariance", "likelihood", "residuals", "prediction", "summary", "anova", "contrast"]
    },
    {
      "title": "Penalty and alternative covariance output",
      "properties": {
        "ok": {"const": true},
        "protocol_version": {"const": "1"},
        "operation": {"const": "regularization_covariance"},
        "estimator": {"enum": ["ols", "glm-binomial", "lrm-binary"]},
        "coefficient_names": {"$ref": "#/$defs/nameVector"},
        "penalized": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/penalizedResult"}
          ]
        },
        "robust": {"$ref": "#/$defs/covarianceEstimate"},
        "bootstrap": {"$ref": "#/$defs/covarianceEstimate"}
      },
      "required": ["ok", "protocol_version", "operation", "estimator", "coefficient_names", "penalized", "robust", "bootstrap"]
    },
    {
      "title": "Ordinal regression output",
      "allOf": [
        {"$ref": "#/$defs/modelFitOutput"},
        {
          "properties": {
            "operation": {"const": "orm"},
            "family": {"enum": ["logistic", "probit", "loglog", "cloglog", "cauchit"]},
            "response": {"$ref": "#/$defs/numericVector"},
            "response_levels": {"$ref": "#/$defs/numericVector"},
            "probability_names": {"$ref": "#/$defs/nameVector"},
            "fitted_probabilities": {"$ref": "#/$defs/numericMatrix"}
          },
          "required": ["operation", "family", "response", "response_levels", "probability_names", "fitted_probabilities"]
        }
      ]
    },
    {
      "title": "Censored ordinal regression output",
      "allOf": [
        {"$ref": "#/$defs/modelFitOutput"},
        {
          "properties": {
            "operation": {"const": "orm_censored"},
            "family": {"enum": ["logistic", "probit", "loglog", "cloglog", "cauchit"]},
            "censoring_types": {"type": "array", "items": {"enum": ["exact", "left", "right", "interval"]}},
            "response_levels": {"$ref": "#/$defs/numericVector"},
            "turnbull_lower": {"$ref": "#/$defs/numericVector"},
            "turnbull_upper": {"$ref": "#/$defs/numericVector"},
            "turnbull_probabilities": {"$ref": "#/$defs/numericVector"},
            "turnbull_survival": {"$ref": "#/$defs/numericVector"},
            "probability_names": {"$ref": "#/$defs/nameVector"},
            "fitted_probabilities": {"$ref": "#/$defs/numericMatrix"}
          },
          "required": ["operation", "family", "censoring_types", "response_levels", "turnbull_lower", "turnbull_upper", "turnbull_probabilities", "turnbull_survival", "probability_names", "fitted_probabilities"]
        }
      ]
    },
    {
      "title": "Clustered ordinal regression output",
      "properties": {
        "ok": {"const": true},
        "protocol_version": {"const": "1"},
        "operation": {"const": "orm_random"},
        "basis": {"const": "linear"},
        "family": {"enum": ["logistic", "probit", "loglog", "cloglog", "cauchit"]},
        "parameter_names": {"$ref": "#/$defs/nameVector"},
        "parameters": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number"}},
        "covariance_names": {"$ref": "#/$defs/nameVector"},
        "covariance": {"$ref": "#/$defs/numericMatrix"},
        "response_levels": {"$ref": "#/$defs/numericVector"},
        "linear_predictors": {"$ref": "#/$defs/numericVector"},
        "deviance": {"$ref": "#/$defs/numericVector"},
        "cluster_count": {"type": "integer", "minimum": 2},
        "sigma": {"oneOf": [{"type": "null"}, {"type": "number", "exclusiveMinimum": 0}]},
        "sigma1": {"oneOf": [{"type": "null"}, {"type": "number", "exclusiveMinimum": 0}]},
        "sigma2": {"oneOf": [{"type": "null"}, {"type": "number"}]}
      },
      "required": ["ok", "protocol_version", "operation", "basis", "family", "parameter_names", "parameters", "covariance_names", "covariance", "response_levels", "linear_predictors", "deviance", "cluster_count", "sigma", "sigma1", "sigma2"]
    },
    {
      "title": "Cox proportional hazards output",
      "allOf": [
        {"$ref": "#/$defs/survivalFitOutput"},
        {
          "properties": {
            "operation": {"const": "cph"},
            "method": {"enum": ["efron", "breslow"]}
          },
          "required": ["operation", "method"]
        }
      ]
    },
    {
      "title": "Parametric survival output",
      "allOf": [
        {"$ref": "#/$defs/survivalFitOutput"},
        {
          "properties": {
            "operation": {"const": "psm"},
            "distribution": {"enum": ["weibull", "exponential"]},
            "scale": {"oneOf": [{"type": "null"}, {"type": "number", "exclusiveMinimum": 0}]}
          },
          "required": ["operation", "distribution", "scale"]
        }
      ]
    },
    {
      "title": "Nonparametric survival output",
      "properties": {
        "ok": {"const": true},
        "protocol_version": {"const": "1"},
        "operation": {"const": "npsurv"},
        "estimator": {"const": "kaplan-meier"},
        "observations": {"type": "number", "minimum": 1},
        "time": {"$ref": "#/$defs/numericVector"},
        "strata": {"$ref": "#/$defs/nameVector"},
        "entry": {"$ref": "#/$defs/numericVector"},
        "weights": {"$ref": "#/$defs/numericVector"},
        "n_risk": {"$ref": "#/$defs/numericVector"},
        "n_event": {"$ref": "#/$defs/numericVector"},
        "n_censor": {"$ref": "#/$defs/numericVector"},
        "survival": {"$ref": "#/$defs/numericVector"},
        "standard_error": {"$ref": "#/$defs/numericVector"},
        "lower": {"$ref": "#/$defs/numericVector"},
        "upper": {"$ref": "#/$defs/numericVector"}
      },
      "required": ["ok", "protocol_version", "operation", "estimator", "observations", "time", "n_risk", "n_event", "n_censor", "survival", "standard_error", "lower", "upper"]
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$|^[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "reference": {
      "type": "object",
      "properties": {
        "package": {"const": "rms"},
        "version": {"const": "8.2-0"},
        "commit": {"$ref": "#/$defs/gitCommit"},
        "protocol_version": {"const": "1"}
      },
      "required": ["package", "version", "commit", "protocol_version"],
      "additionalProperties": false
    },
    "healthResponse": {
      "type": "object",
      "properties": {
        "ok": {"const": true},
        "protocol_version": {"const": "1"},
        "operation": {"const": "health"},
        "r_version": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "packages": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "package_repository": {"type": "string", "minLength": 1},
        "repositories": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string"}
        },
        "external_libraries": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "external_library_names": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "rng_kind": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "string", "minLength": 1}
        },
        "registered_fortran": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "locale": {"type": "string", "minLength": 1},
        "timezone": {"type": "string", "minLength": 1}
      },
      "required": [
        "ok",
        "protocol_version",
        "operation",
        "r_version",
        "platform",
        "packages",
        "package_repository",
        "repositories",
        "external_libraries",
        "external_library_names",
        "rng_kind",
        "registered_fortran",
        "locale",
        "timezone"
      ],
      "additionalProperties": false
    },
    "numericVector": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "number"}
    },
    "numericMatrix": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/numericVector"}
    },
    "nameVector": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "termSlice": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 1}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "designMainEffect": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {"const": "identity"},
            "variable": {"type": "string", "minLength": 1, "maxLength": 256}
          },
          "required": ["kind", "variable"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {"const": "polynomial"},
            "variable": {"type": "string", "minLength": 1, "maxLength": 256},
            "degree": {"type": "integer", "minimum": 2, "maximum": 10}
          },
          "required": ["kind", "variable", "degree"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {"const": "linear_spline"},
            "variable": {"type": "string", "minLength": 1, "maxLength": 256},
            "knots": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {"type": "number"}
            }
          },
          "required": ["kind", "variable", "knots"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {"const": "restricted_cubic_spline"},
            "variable": {"type": "string", "minLength": 1, "maxLength": 256},
            "knots": {
              "type": "array",
              "minItems": 3,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {"type": "number"}
            }
          },
          "required": ["kind", "variable", "knots"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {"const": "categorical"},
            "variable": {"type": "string", "minLength": 1, "maxLength": 256},
            "levels": {
              "type": "array",
              "minItems": 2,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/distributionValue"}
            },
            "unknown_level": {"const": "error"}
          },
          "required": ["kind", "variable", "levels", "unknown_level"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {"const": "ordered"},
            "variable": {"type": "string", "minLength": 1, "maxLength": 256},
            "levels": {
              "type": "array",
              "minItems": 3,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {"type": "number"}
            },
            "unknown_level": {"const": "error"}
          },
          "required": ["kind", "variable", "levels", "unknown_level"],
          "additionalProperties": false
        }
      ]
    },
    "designTerm": {
      "oneOf": [
        {"$ref": "#/$defs/designMainEffect"},
        {
          "type": "object",
          "properties": {
            "kind": {"const": "restricted_interaction"},
            "left": {"$ref": "#/$defs/designMainEffect"},
            "right": {"$ref": "#/$defs/designMainEffect"}
          },
          "required": ["kind", "left", "right"],
          "additionalProperties": false
        }
      ]
    },
    "integerVector": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer"}
    },
    "nullableInteger": {
      "oneOf": [
        {"type": "null"},
        {"type": "integer"}
      ]
    },
    "likelihoodResult": {
      "type": "object",
      "properties": {
        "log_likelihood": {"type": "number"},
        "null_log_likelihood": {"type": "number"},
        "parameter_count": {"type": "integer", "minimum": 1},
        "aic": {"type": "number"},
        "likelihood_ratio": {"type": "number", "minimum": 0},
        "degrees_of_freedom": {"type": "integer", "minimum": 0},
        "p_value": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "required": ["log_likelihood", "null_log_likelihood", "parameter_count", "aic", "likelihood_ratio", "degrees_of_freedom", "p_value"],
      "additionalProperties": false
    },
    "residualResult": {
      "type": "object",
      "properties": {
        "ordinary": {"$ref": "#/$defs/numericVector"},
        "standardized": {"$ref": "#/$defs/numericVector"},
        "pearson": {"$ref": "#/$defs/numericVector"},
        "deviance": {"$ref": "#/$defs/numericVector"}
      },
      "required": ["ordinary"],
      "additionalProperties": false
    },
    "predictionResult": {
      "type": "object",
      "properties": {
        "scale": {"const": "linear"},
        "interval": {"const": "mean"},
        "confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "values": {"$ref": "#/$defs/numericVector"},
        "standard_errors": {"$ref": "#/$defs/numericVector"},
        "lower": {"$ref": "#/$defs/numericVector"},
        "upper": {"$ref": "#/$defs/numericVector"}
      },
      "required": ["scale", "interval", "confidence_level", "values", "standard_errors", "lower", "upper"],
      "additionalProperties": false
    },
    "inferenceEstimate": {
      "type": "object",
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "estimate": {"type": "number"},
        "standard_error": {"type": "number", "exclusiveMinimum": 0},
        "statistic": {"type": "number"},
        "distribution": {"enum": ["normal", "t"]},
        "degrees_of_freedom": {"$ref": "#/$defs/nullableInteger"},
        "p_value": {"type": "number", "minimum": 0, "maximum": 1},
        "lower": {"type": "number"},
        "upper": {"type": "number"}
      },
      "required": ["name", "estimate", "standard_error", "statistic", "distribution", "degrees_of_freedom", "p_value", "lower", "upper"],
      "additionalProperties": false
    },
    "anovaTest": {
      "type": "object",
      "properties": {
        "term": {"type": "string", "minLength": 1},
        "coefficient_names": {"$ref": "#/$defs/nameVector"},
        "statistic": {"type": "number", "minimum": 0},
        "distribution": {"enum": ["chi-square", "f"]},
        "degrees_of_freedom": {"type": "integer", "minimum": 1},
        "denominator_degrees_of_freedom": {"$ref": "#/$defs/nullableInteger"},
        "p_value": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "required": ["term", "coefficient_names", "statistic", "distribution", "degrees_of_freedom", "denominator_degrees_of_freedom", "p_value"],
      "additionalProperties": false
    },
    "penalizedResult": {
      "type": "object",
      "properties": {
        "coefficients": {"$ref": "#/$defs/numericVector"},
        "covariance": {"$ref": "#/$defs/numericMatrix"},
        "linear_predictors": {"$ref": "#/$defs/numericVector"},
        "fitted_values": {"$ref": "#/$defs/numericVector"},
        "residuals": {"$ref": "#/$defs/numericVector"},
        "penalty_weights": {"$ref": "#/$defs/numericVector"},
        "effective_degrees_of_freedom": {"type": "number", "exclusiveMinimum": 0},
        "residual_degrees_of_freedom": {"oneOf": [{"type": "null"}, {"type": "number", "exclusiveMinimum": 0}]},
        "residual_scale": {"oneOf": [{"type": "null"}, {"type": "number", "exclusiveMinimum": 0}]}
      },
