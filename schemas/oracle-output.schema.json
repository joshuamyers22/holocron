{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joshuamyers22/holocron/schemas/oracle-output.schema.json",
  "title": "Holocron committed oracle output",
  "description": "A versioned expected response from the pinned R rms oracle.",
  "type": "object",
  "properties": {
    "schema_version": {"const": "holocron-oracle-output/v1"},
    "case_id": {"$ref": "#/$defs/identifier"},
    "reference": {"$ref": "#/$defs/reference"}
  },
  "required": ["schema_version", "case_id", "reference"],
  "oneOf": [
    {
      "title": "Oracle environment health output",
      "properties": {
        "oracle_image": {"type": "string", "minLength": 1},
        "oracle_image_digest": {"$ref": "#/$defs/sha256"},
        "rms_commit": {"$ref": "#/$defs/gitCommit"},
        "rms_file_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "rms_description_sha256": {"$ref": "#/$defs/sha256"},
        "hmisc_commit": {"$ref": "#/$defs/gitCommit"},
        "response": {"$ref": "#/$defs/healthResponse"}
      },
      "required": [
        "oracle_image",
        "oracle_image_digest",
        "rms_commit",
        "rms_file_manifest_sha256",
        "rms_description_sha256",
        "hmisc_commit",
        "response"
      ]
    },
    {
      "title": "Restricted cubic spline design output",
      "properties": {
        "ok": {"const": true},
        "protocol_version": {"const": "1"},
        "operation": {"const": "rcs"},
        "x": {"$ref": "#/$defs/numericVector"},
        "knots": {"$ref": "#/$defs/numericVector"},
        "nonlinear_mask": {
          "type": "array",
          "items": {"type": "boolean"}
        },
        "nonlinear_columns": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0}
        },
        "column_names": {"$ref": "#/$defs/nameVector"},
        "basis": {"$ref": "#/$defs/numericMatrix"}
      },
      "required": [
        "ok",
        "protocol_version",
        "operation",
        "x",
        "knots",
        "nonlinear_mask",
        "nonlinear_columns",
        "column_names",
        "basis"
      ]
    },
    {
      "title": "OLS with restricted cubic splines output",
      "properties": {
        "ok": {"const": true},
        "protocol_version": {"const": "1"},
        "operation": {"const": "ols_rcs"},
        "knots": {"$ref": "#/$defs/numericVector"},
        "coefficient_names": {"$ref": "#/$defs/nameVector"},
        "coefficients": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "number"}
        },
        "covariance_names": {"$ref": "#/$defs/nameVector"},
        "covariance": {"$ref": "#/$defs/numericMatrix"},
        "design_names": {"$ref": "#/$defs/nameVector"},
        "design": {"$ref": "#/$defs/numericMatrix"},
        "fitted": {"$ref": "#/$defs/numericVector"},
        "residuals": {"$ref": "#/$defs/numericVector"},
        "degrees_of_freedom": {"type": "integer", "minimum": 1},
        "sigma": {"type": "number", "exclusiveMinimum": 0}
      },
      "required": [
        "ok",
        "protocol_version",
        "operation",
        "knots",
        "coefficient_names",
        "coefficients",
        "covariance_names",
        "covariance",
        "design_names",
        "design",
        "fitted",
        "residuals",
        "degrees_of_freedom",
        "sigma"
      ]
    },
    {
      "title": "Predictor data-distribution output",
      "properties": {
        "ok": {"const": true},
        "protocol_version": {"const": "1"},
        "operation": {"const": "datadist"},
        "observation_count": {"type": "integer", "minimum": 2},
        "effect_quantiles": {"$ref": "#/$defs/quantilePair"},
        "display_quantiles": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/quantilePair"}
          ]
        },
        "categorical_adjustment": {"enum": ["mode", "first"]},
        "discrete_threshold": {"type": "integer", "minimum": 1},
        "variables": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/distributionVariable"}
        }
      },
      "required": [
        "ok",
        "protocol_version",
        "operation",
        "observation_count",
        "effect_quantiles",
        "display_quantiles",
        "categorical_adjustment",
        "discrete_threshold",
        "variables"
      ]
    },
    {
      "title": "Binary logistic regression output",
      "allOf": [
        {"$ref": "#/$defs/modelFitOutput"},
        {
          "properties": {
            "operation": {"const": "lrm"},
            "response": {"$ref": "#/$defs/integerVector"},
            "fitted_probability": {"$ref": "#/$defs/numericVector"}
          },
          "required": ["operation", "response", "fitted_probability"]
        }
      ]
    },
    {
      "title": "Ordinal regression output",
      "allOf": [
        {"$ref": "#/$defs/modelFitOutput"},
        {
          "properties": {
            "operation": {"const": "orm"},
            "family": {"enum": ["logistic", "probit", "loglog", "cloglog", "cauchit"]},
            "response": {"$ref": "#/$defs/numericVector"},
            "response_levels": {"$ref": "#/$defs/numericVector"},
            "probability_names": {"$ref": "#/$defs/nameVector"},
            "fitted_probabilities": {"$ref": "#/$defs/numericMatrix"}
          },
          "required": ["operation", "family", "response", "response_levels", "probability_names", "fitted_probabilities"]
        }
      ]
    },
    {
      "title": "Cox proportional hazards output",
      "allOf": [
        {"$ref": "#/$defs/survivalFitOutput"},
        {
          "properties": {
            "operation": {"const": "cph"},
            "method": {"enum": ["efron", "breslow"]}
          },
          "required": ["operation", "method"]
        }
      ]
    },
    {
      "title": "Parametric survival output",
      "allOf": [
        {"$ref": "#/$defs/survivalFitOutput"},
        {
          "properties": {
            "operation": {"const": "psm"},
            "distribution": {"enum": ["weibull", "exponential"]},
            "scale": {"type": "number", "exclusiveMinimum": 0}
          },
          "required": ["operation", "distribution", "scale"]
        }
      ]
    },
    {
      "title": "Nonparametric survival output",
      "properties": {
        "ok": {"const": true},
        "protocol_version": {"const": "1"},
        "operation": {"const": "npsurv"},
        "estimator": {"const": "kaplan-meier"},
        "observations": {"type": "number", "minimum": 1},
        "time": {"$ref": "#/$defs/numericVector"},
        "n_risk": {"$ref": "#/$defs/numericVector"},
        "n_event": {"$ref": "#/$defs/numericVector"},
        "n_censor": {"$ref": "#/$defs/numericVector"},
        "survival": {"$ref": "#/$defs/numericVector"},
        "standard_error": {"$ref": "#/$defs/numericVector"},
        "lower": {"$ref": "#/$defs/numericVector"},
        "upper": {"$ref": "#/$defs/numericVector"}
      },
      "required": ["ok", "protocol_version", "operation", "estimator", "observations", "time", "n_risk", "n_event", "n_censor", "survival", "standard_error", "lower", "upper"]
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$|^[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "reference": {
      "type": "object",
      "properties": {
        "package": {"const": "rms"},
        "version": {"const": "8.2-0"},
        "commit": {"$ref": "#/$defs/gitCommit"},
        "protocol_version": {"const": "1"}
      },
      "required": ["package", "version", "commit", "protocol_version"],
      "additionalProperties": false
    },
    "healthResponse": {
      "type": "object",
      "properties": {
        "ok": {"const": true},
        "protocol_version": {"const": "1"},
        "operation": {"const": "health"},
        "r_version": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "packages": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "package_repository": {"type": "string", "minLength": 1},
        "repositories": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string"}
        },
        "external_libraries": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "external_library_names": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "rng_kind": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "string", "minLength": 1}
        },
        "registered_fortran": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "locale": {"type": "string", "minLength": 1},
        "timezone": {"type": "string", "minLength": 1}
      },
      "required": [
        "ok",
        "protocol_version",
        "operation",
        "r_version",
        "platform",
        "packages",
        "package_repository",
        "repositories",
        "external_libraries",
        "external_library_names",
        "rng_kind",
        "registered_fortran",
        "locale",
        "timezone"
      ],
      "additionalProperties": false
    },
    "numericVector": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "number"}
    },
    "numericMatrix": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/numericVector"}
    },
    "nameVector": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "integerVector": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer"}
    },
    "distributionValue": {
      "oneOf": [
        {"type": "number"},
        {"type": "string", "minLength": 1}
      ]
    },
    "distributionRange": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/distributionValue"}
    },
    "quantilePair": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "distributionVariable": {
      "type": "object",
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["continuous", "discrete", "categorical", "ordered"]},
        "adjustment": {"$ref": "#/$defs/distributionValue"},
        "effect_range": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/distributionRange"}
          ]
        },
        "display_range": {"$ref": "#/$defs/distributionRange"},
        "overall_range": {"$ref": "#/$defs/distributionRange"},
        "values": {
          "type": "array",
          "items": {"$ref": "#/$defs/distributionValue"},
          "uniqueItems": true
        },
        "label": {"type": "string", "minLength": 1},
        "unit": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1}
          ]
        },
        "nonmissing_count": {"type": "integer", "minimum": 1},
        "missing_count": {"type": "integer", "minimum": 0}
      },
      "required": [
        "name",
        "kind",
        "adjustment",
        "effect_range",
        "display_range",
        "overall_range",
        "values",
        "label",
        "unit",
        "nonmissing_count",
        "missing_count"
      ],
      "additionalProperties": false
    },
    "modelFitOutput": {
      "type": "object",
      "properties": {
        "ok": {"const": true},
        "protocol_version": {"const": "1"},
        "basis": {"enum": ["linear", "rcs"]},
        "knots": {"type": "array", "items": {"type": "number"}},
        "coefficient_names": {"$ref": "#/$defs/nameVector"},
        "coefficients": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "number"}
        },
        "covariance_names": {"$ref": "#/$defs/nameVector"},
        "covariance": {"$ref": "#/$defs/numericMatrix"},
        "design_names": {"$ref": "#/$defs/nameVector"},
        "design": {"$ref": "#/$defs/numericMatrix"},
        "linear_predictors": {"$ref": "#/$defs/numericVector"},
        "deviance": {"$ref": "#/$defs/numericVector"}
      },
      "required": ["ok", "protocol_version", "basis", "knots", "coefficient_names", "coefficients", "covariance_names", "covariance", "design_names", "design", "linear_predictors", "deviance"]
    },
    "survivalFitOutput": {
      "type": "object",
      "properties": {
        "ok": {"const": true},
        "protocol_version": {"const": "1"},
        "basis": {"enum": ["linear", "rcs"]},
        "knots": {"type": "array", "items": {"type": "number"}},
        "coefficient_names": {"$ref": "#/$defs/nameVector"},
        "coefficients": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "number"}
        },
        "covariance_names": {"$ref": "#/$defs/nameVector"},
        "covariance": {"$ref": "#/$defs/numericMatrix"},
        "design_names": {"$ref": "#/$defs/nameVector"},
        "design": {"$ref": "#/$defs/numericMatrix"},
        "linear_predictors": {"$ref": "#/$defs/numericVector"},
        "log_likelihood": {"$ref": "#/$defs/numericVector"},
        "evaluation_x": {"$ref": "#/$defs/numericVector"},
        "evaluation_linear_predictors": {"$ref": "#/$defs/numericVector"},
        "evaluation_times": {"$ref": "#/$defs/numericVector"},
        "predicted_survival": {"$ref": "#/$defs/numericMatrix"}
      },
      "required": ["ok", "protocol_version", "basis", "knots", "coefficient_names", "coefficients", "covariance_names", "covariance", "design_names", "design", "linear_predictors", "log_likelihood", "evaluation_x", "evaluation_linear_predictors", "evaluation_times", "predicted_survival"]
    }
  }
}
