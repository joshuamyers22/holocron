{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joshuamyers22/holocron/schemas/phase-9-review-set.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {"const": "holocron-phase-9-review-set/v1"},
    "review_set_id": {"const": "phase-9-technical-reviews-v1"},
    "reviewed_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "reviewed_on": {"type": "string", "format": "date"},
    "reviewer": {
      "type": "object",
      "properties": {
        "reviewer_id": {"const": "ron-mexico"},
        "display_name": {"const": "Ron Mexico"},
        "independence_attested": {"const": true}
      },
      "required": ["reviewer_id", "display_name", "independence_attested"],
      "additionalProperties": false
    },
    "decision": {"const": "approved"},
    "unresolved_findings": {"const": []},
    "reviews": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "domain": {"enum": ["statistical", "numerical", "security", "api", "documentation"]},
          "record_path": {"type": "string", "minLength": 1},
          "decision": {"const": "approved"},
          "scope": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "exclusions": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        },
        "required": ["domain", "record_path", "decision", "scope", "evidence", "exclusions"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "review_set_id",
    "reviewed_revision",
    "reviewed_on",
    "reviewer",
    "decision",
    "unresolved_findings",
    "reviews"
  ],
  "additionalProperties": false
}
