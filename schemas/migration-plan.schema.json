{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joshuamyers22/holocron/schemas/migration-plan.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {"const": "holocron-rms-migration-plan/v1"},
    "reference": {
      "type": "object",
      "properties": {
        "package": {"const": "rms"},
        "version": {"const": "8.2-0"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      },
      "required": ["package", "version", "commit"],
      "additionalProperties": false
    },
    "catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requested_symbols": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "matches": {"type": "array", "items": {"$ref": "#/$defs/match"}},
    "unknown_symbols": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "summary": {
      "type": "object",
      "properties": {
        "implemented": {"type": "integer", "minimum": 0},
        "experimental": {"type": "integer", "minimum": 0},
        "mapped": {"type": "integer", "minimum": 0},
        "unsupported": {"type": "integer", "minimum": 0},
        "unknown": {"type": "integer", "minimum": 0},
        "ready": {"type": "boolean"}
      },
      "required": ["implemented", "experimental", "mapped", "unsupported", "unknown", "ready"],
      "additionalProperties": false
    }
  },
  "required": ["schema_version", "reference", "catalog_sha256", "requested_symbols", "matches", "unknown_symbols", "summary"],
  "additionalProperties": false,
  "$defs": {
    "entry": {
      "type": "object",
      "properties": {
        "identifier": {"type": "string", "minLength": 1, "maxLength": 512},
        "r_symbol": {"type": "string", "minLength": 1, "maxLength": 256},
        "kind": {"enum": ["export", "s3_method"]},
        "disposition": {"enum": ["implemented", "experimental", "mapped", "unsupported"]},
        "python_entry_point": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^holocron\\."}]},
        "guidance": {"type": "string", "minLength": 40, "maxLength": 32768}
      },
      "required": ["identifier", "r_symbol", "kind", "disposition", "python_entry_point", "guidance"],
      "additionalProperties": false
    },
    "match": {
      "type": "object",
      "properties": {
        "query": {"type": "string", "minLength": 1, "maxLength": 512},
        "entry": {"$ref": "#/$defs/entry"}
      },
      "required": ["query", "entry"],
      "additionalProperties": false
    }
  }
}
