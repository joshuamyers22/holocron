{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joshuamyers22/holocron/schemas/phase-4-edge-corpus.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {"const": "holocron-phase-4-edge-corpus/v1"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "action": {"enum": ["two_levels", "rank_deficient", "invalid_interval", "no_exact", "one_sided", "constant_mix", "single_cluster", "invalid_grid", "fixed_nonconvergence"]},
          "expected_exception": {"oneOf": [{"type": "null"}, {"enum": ["InputValidationError", "RankDeficiencyError", "ConvergenceError"]}]}
        },
        "required": ["id", "action", "expected_exception"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "cases"],
  "additionalProperties": false
}
