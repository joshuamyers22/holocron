{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joshuamyers22/holocron/schemas/formula.schema.json",
  "title": "Holocron formula AST",
  "description": "The versioned, allowlisted additive numeric formula syntax tree.",
  "type": "object",
  "properties": {
    "schema_version": {"const": "holocron-formula/v1"},
    "response": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/name"}
      ]
    },
    "include_intercept": {"type": "boolean"},
    "terms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/term"}
    }
  },
  "required": ["schema_version", "response", "include_intercept", "terms"],
  "additionalProperties": false,
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "knots": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "number"}
    },
    "term": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {"const": "identity"},
            "variable": {"$ref": "#/$defs/name"}
          },
          "required": ["kind", "variable"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {"const": "polynomial"},
            "variable": {"$ref": "#/$defs/name"},
            "degree": {"type": "integer", "minimum": 2, "maximum": 10}
          },
          "required": ["kind", "variable", "degree"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {"const": "linear_spline"},
            "variable": {"$ref": "#/$defs/name"},
            "knots": {
              "allOf": [
                {"$ref": "#/$defs/knots"},
                {"minItems": 1}
              ]
            }
          },
          "required": ["kind", "variable", "knots"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {"const": "restricted_cubic_spline"},
            "variable": {"$ref": "#/$defs/name"},
            "knots": {
              "allOf": [
                {"$ref": "#/$defs/knots"},
                {"minItems": 3}
              ]
            }
          },
          "required": ["kind", "variable", "knots"],
          "additionalProperties": false
        }
      ]
    }
  }
}
