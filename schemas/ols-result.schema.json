{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joshuamyers22/holocron/schemas/ols-result.schema.json",
  "title": "Holocron ordinary least-squares result",
  "description": "A complete, non-executable, reconstructible result from the supported full-rank OLS fit.",
  "type": "object",
  "properties": {
    "schema_version": {"const": "holocron-ols-result/v1"},
    "result_type": {"const": "ordinary_least_squares"},
    "coefficient_names": {
      "type": "array",
      "minItems": 1,
      "maxItems": 257,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 1024}
    },
    "coefficients": {"$ref": "#/$defs/parameterVector"},
    "covariance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 257,
      "items": {"$ref": "#/$defs/parameterVector"}
    },
    "fitted_values": {"$ref": "#/$defs/observationVector"},
    "residuals": {"$ref": "#/$defs/observationVector"},
    "residual_degrees_of_freedom": {"type": "integer", "minimum": 1},
    "residual_scale": {"type": "number", "minimum": 0},
    "rank": {"type": "integer", "minimum": 1, "maximum": 257},
    "n_observations": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "n_features": {"type": "integer", "minimum": 1, "maximum": 256},
    "includes_intercept": {"type": "boolean"},
    "design_fingerprint": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    }
  },
  "required": [
    "schema_version",
    "result_type",
    "coefficient_names",
    "coefficients",
    "covariance",
    "fitted_values",
    "residuals",
    "residual_degrees_of_freedom",
    "residual_scale",
    "rank",
    "n_observations",
    "n_features",
    "includes_intercept",
    "design_fingerprint"
  ],
  "additionalProperties": false,
  "$defs": {
    "parameterVector": {
      "type": "array",
      "minItems": 1,
      "maxItems": 257,
      "items": {"type": "number"}
    },
    "observationVector": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000000,
      "items": {"type": "number"}
    }
  }
}
