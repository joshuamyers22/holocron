{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joshuamyers22/holocron/schemas/design-matrix.schema.json",
  "title": "Holocron design matrix",
  "description": "A bounded numeric design matrix linked to an immutable design specification.",
  "type": "object",
  "properties": {
    "schema_version": {"const": "holocron-design-matrix/v1"},
    "column_names": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/name"}
    },
    "nonlinear_mask": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"type": "boolean"}
    },
    "term_slices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/slice"}
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000000,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 256,
        "items": {"type": "number"}
      }
    },
    "specification_fingerprint": {"$ref": "#/$defs/sha256"},
    "include_intercept": {"type": "boolean"}
  },
  "required": [
    "schema_version",
    "column_names",
    "nonlinear_mask",
    "term_slices",
    "rows",
    "specification_fingerprint",
    "include_intercept"
  ],
  "additionalProperties": false,
  "$defs": {
    "name": {"type": "string", "minLength": 1, "maxLength": 1024},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "slice": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 1}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    }
  }
}
