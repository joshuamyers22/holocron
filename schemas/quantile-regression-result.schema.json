{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joshuamyers22/holocron/schemas/quantile-regression-result.schema.json",
  "title": "Holocron single-quantile regression result",
  "type": "object",
  "properties": {
    "schema_version": {"const": "holocron-quantile-regression-result/v1"},
    "quantile": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "coefficient_names": {"$ref": "#/$defs/names"},
    "coefficients": {"$ref": "#/$defs/parameters"},
    "covariance": {"$ref": "#/$defs/matrix"},
    "fitted_values": {"$ref": "#/$defs/observations"},
    "residuals": {"$ref": "#/$defs/observations"},
    "objective": {"type": "number", "minimum": 0},
    "iterations": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "n_observations": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "n_features": {"type": "integer", "minimum": 1, "maximum": 256},
    "includes_intercept": {"type": "boolean"},
    "design_fingerprint": {"$ref": "#/$defs/nullableFingerprint"}
  },
  "required": [
    "schema_version", "quantile", "coefficient_names", "coefficients",
    "covariance", "fitted_values", "residuals", "objective", "iterations",
    "n_observations", "n_features", "includes_intercept", "design_fingerprint"
  ],
  "additionalProperties": false,
  "$defs": {
    "names": {"type": "array", "minItems": 1, "maxItems": 257, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "parameters": {"type": "array", "minItems": 1, "maxItems": 257, "items": {"type": "number"}},
    "matrix": {"type": "array", "minItems": 1, "maxItems": 257, "items": {"$ref": "#/$defs/parameters"}},
    "observations": {"type": "array", "minItems": 1, "maxItems": 1000000, "items": {"type": "number"}},
    "nullableFingerprint": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]}
  }
}
