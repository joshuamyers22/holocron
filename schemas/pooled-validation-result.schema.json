{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://holocron.dev/schemas/pooled-validation-result.schema.json",
  "title": "Holocron pooled multiple-imputation validation result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model_family", "metrics", "n_imputations", "source_statuses", "source_failure_rates"],
  "properties": {
    "schema_version": {"const": "holocron-pooled-validation-result/v1"},
    "model_family": {"enum": ["ols", "binary-logistic"]},
    "metrics": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {"$ref": "#/$defs/metric"}
    },
    "n_imputations": {"type": "integer", "minimum": 2, "maximum": 1000},
    "source_statuses": {"$ref": "#/$defs/statuses"},
    "source_failure_rates": {"$ref": "#/$defs/probabilities"}
  },
  "$defs": {
    "nullableNumber": {"type": ["number", "null"]},
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "apparent", "mean_training", "mean_assessment", "optimism", "corrected", "contributing_imputations", "contributing_resamples"],
      "properties": {
        "name": {"enum": ["r_squared", "mean_squared_error", "dxy", "brier_score", "calibration_intercept", "calibration_slope"]},
        "apparent": {"$ref": "#/$defs/nullableNumber"},
        "mean_training": {"$ref": "#/$defs/nullableNumber"},
        "mean_assessment": {"$ref": "#/$defs/nullableNumber"},
        "optimism": {"$ref": "#/$defs/nullableNumber"},
        "corrected": {"$ref": "#/$defs/nullableNumber"},
        "contributing_imputations": {"type": "integer", "minimum": 0, "maximum": 1000},
        "contributing_resamples": {"type": "integer", "minimum": 0, "maximum": 10000000}
      }
    },
    "statuses": {
      "type": "array", "minItems": 2, "maxItems": 1000,
      "items": {"enum": ["complete", "partial", "failed"]}
    },
    "probabilities": {
      "type": "array", "minItems": 2, "maxItems": 1000,
      "items": {"type": "number", "minimum": 0, "maximum": 1}
    }
  }
}
