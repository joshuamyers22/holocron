{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joshuamyers22/holocron/schemas/phase-3-edge-report.schema.json",
  "title": "Holocron Phase 3 numerical edge report",
  "type": "object",
  "properties": {
    "schema_version": {"const": "holocron-phase-3-edge-report/v1"},
    "evaluated_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$"},
    "corpus_id": {"const": "phase-3-core-numerical-edges-v1"},
    "corpus_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object",
      "properties": {
        "code_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$|^unknown$"},
        "working_tree_dirty": {"type": "boolean"}
      },
      "required": ["code_revision", "working_tree_dirty"],
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "expected_outcome": {"enum": ["success", "error"]},
          "observed_exception": {"type": ["string", "null"]},
          "checks": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "outcome": {"const": "passed"}
        },
        "required": ["case_id", "expected_outcome", "observed_exception", "checks", "outcome"],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "case_count": {"type": "integer", "minimum": 12},
        "categories": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "failed_cases": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "outcome": {"const": "passed"}
      },
      "required": ["case_count", "categories", "failed_cases", "outcome"],
      "additionalProperties": false
    },
    "outcome": {"const": "passed"}
  },
  "required": ["schema_version", "evaluated_at_utc", "corpus_id", "corpus_sha256", "source", "cases", "summary", "outcome"],
  "additionalProperties": false
}
