{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joshuamyers22/holocron/schemas/phase-2-exit-evidence.schema.json",
  "title": "Holocron Phase 2 exit evidence",
  "description": "A repeatable, auditable record of the complete Phase 2 design-system exit gate.",
  "type": "object",
  "properties": {
    "schema_version": {"const": "holocron-phase-2-exit-evidence/v1"},
    "evidence_id": {"$ref": "#/$defs/sha256"},
    "evaluated_at_utc": {"$ref": "#/$defs/timestamp"},
    "source": {
      "type": "object",
      "properties": {
        "code_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$|^unknown$"},
        "working_tree_dirty": {"type": "boolean"}
      },
      "required": ["code_revision", "working_tree_dirty"],
      "additionalProperties": false
    },
    "oracle": {"$ref": "#/$defs/oracle"},
    "implementation": {
      "type": "object",
      "properties": {
        "package": {"const": "holocron-rms"},
        "version": {"type": "string", "minLength": 1},
        "python_implementation": {"type": "string", "minLength": 1},
        "python_version": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1}
      },
      "required": ["package", "version", "python_implementation", "python_version", "platform"],
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "qualification_stage": {"const": "python-parity"},
        "operations": {
          "type": "array",
          "prefixItems": [
            {"const": "datadist"},
            {"const": "design"},
            {"const": "rcs"}
          ],
          "items": false
        },
        "case_count": {"type": "integer", "minimum": 18}
      },
      "required": ["qualification_stage", "operations", "case_count"],
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 18,
      "items": {"$ref": "#/$defs/case_result"}
    },
    "comparison_summary": {
      "type": "object",
      "properties": {
        "outcome": {"$ref": "#/$defs/outcome"},
        "exact_comparisons": {"type": "integer", "minimum": 1},
        "numeric_comparisons": {"type": "integer", "minimum": 1},
        "maximum_absolute_error": {"type": "number", "minimum": 0},
        "maximum_relative_error": {"type": "number", "minimum": 0},
        "profiles": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "failed_cases": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/case_id"}
        }
      },
      "required": ["outcome", "exact_comparisons", "numeric_comparisons", "maximum_absolute_error", "maximum_relative_error", "profiles", "failed_cases"],
      "additionalProperties": false
    },
    "adversarial_naming": {
      "type": "object",
      "properties": {
        "case_id": {"const": "design-adversarial-names"},
        "outcome": {"const": "passed"}
      },
      "required": ["case_id", "outcome"],
      "additionalProperties": false
    },
    "prediction_reconstruction": {
      "type": "object",
      "properties": {
        "source_case_id": {"const": "design-adversarial-names"},
        "design_spec_schema_version": {"const": "holocron-design-spec/v2"},
        "design_matrix_schema_version": {"const": "holocron-design-matrix/v1"},
        "result_schema_version": {"const": "holocron-ols-result/v1"},
        "design_spec_fingerprint": {"$ref": "#/$defs/sha256"},
        "training_matrix_fingerprint": {"$ref": "#/$defs/sha256"},
        "result_fingerprint": {"$ref": "#/$defs/sha256"},
        "training_rows": {"type": "integer", "minimum": 4},
        "prediction_rows": {"type": "integer", "minimum": 1},
        "maximum_absolute_difference": {"type": "number", "minimum": 0, "maximum": 0},
        "outcome": {"const": "passed"}
      },
      "required": ["source_case_id", "design_spec_schema_version", "design_matrix_schema_version", "result_schema_version", "design_spec_fingerprint", "training_matrix_fingerprint", "result_fingerprint", "training_rows", "prediction_rows", "maximum_absolute_difference", "outcome"],
      "additionalProperties": false
    },
    "estimator_promotion": {
      "type": "object",
      "properties": {
        "statuses": {
          "type": "object",
          "properties": {
            "export:ols": {"const": "experimental"},
            "export:Glm": {"enum": ["deferred", "experimental"]},
            "export:lrm": {"enum": ["deferred", "experimental"]}
          },
          "required": ["export:ols", "export:Glm", "export:lrm"],
          "additionalProperties": false
        },
        "promoted_estimators": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["export:Glm", "export:lrm"]}
        },
        "promotion_evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "outcome": {"const": "passed"}
      },
      "required": ["statuses", "promoted_estimators", "promotion_evidence", "outcome"],
      "additionalProperties": false
    },
    "outcome": {"const": "passed"}
  },
  "required": ["schema_version", "evidence_id", "evaluated_at_utc", "source", "oracle", "implementation", "scope", "cases", "comparison_summary", "adversarial_naming", "prediction_reconstruction", "estimator_promotion", "outcome"],
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$"},
    "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "outcome": {"enum": ["passed", "failed"]},
    "oracle": {
      "type": "object",
      "properties": {
        "package": {"const": "rms"},
        "version": {"const": "8.2-0"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "protocol_version": {"const": "1"}
      },
      "required": ["package", "version", "commit", "protocol_version"],
      "additionalProperties": false
    },
    "case_result": {
      "type": "object",
      "properties": {
        "case_id": {"$ref": "#/$defs/case_id"},
        "operation": {"enum": ["datadist", "design", "rcs"]},
        "case_sha256": {"$ref": "#/$defs/sha256"},
        "expected_output_sha256": {"$ref": "#/$defs/sha256"},
        "actual_output_sha256": {"$ref": "#/$defs/sha256"},
        "profile": {"type": "string", "minLength": 1},
        "outcome": {"$ref": "#/$defs/outcome"},
        "exact_comparisons": {"type": "integer", "minimum": 0},
        "numeric_comparisons": {"type": "integer", "minimum": 0},
        "maximum_absolute_error": {"type": "number", "minimum": 0},
        "maximum_relative_error": {"type": "number", "minimum": 0},
        "mismatches": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "required": ["case_id", "operation", "case_sha256", "expected_output_sha256", "actual_output_sha256", "profile", "outcome", "exact_comparisons", "numeric_comparisons", "maximum_absolute_error", "maximum_relative_error", "mismatches"],
      "additionalProperties": false
    }
  }
}
