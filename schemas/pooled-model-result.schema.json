{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://holocron.dev/schemas/pooled-model-result.schema.json",
  "title": "Holocron pooled multiple-imputation model result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "model_family", "coefficient_names", "coefficients",
    "within_covariance", "between_covariance", "total_covariance",
    "standard_errors", "degrees_of_freedom", "fraction_missing_information",
    "relative_increase_variance", "n_imputations", "n_observations",
    "n_features", "includes_intercept", "complete_data_degrees_of_freedom",
    "design_fingerprint", "source_fingerprints"
  ],
  "properties": {
    "schema_version": {"const": "holocron-pooled-model-result/v1"},
    "model_family": {"enum": ["ols", "glm-binomial", "lrm-binary"]},
    "coefficient_names": {
      "type": "array", "minItems": 1, "maxItems": 257, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "coefficients": {"$ref": "#/$defs/vector"},
    "within_covariance": {"$ref": "#/$defs/matrix"},
    "between_covariance": {"$ref": "#/$defs/matrix"},
    "total_covariance": {"$ref": "#/$defs/matrix"},
    "standard_errors": {"$ref": "#/$defs/nonnegativeVector"},
    "degrees_of_freedom": {"$ref": "#/$defs/positiveVector"},
    "fraction_missing_information": {"$ref": "#/$defs/probabilityVector"},
    "relative_increase_variance": {"$ref": "#/$defs/nonnegativeVector"},
    "n_imputations": {"type": "integer", "minimum": 2, "maximum": 1000},
    "n_observations": {"type": "integer", "minimum": 2, "maximum": 1000000},
    "n_features": {"type": "integer", "minimum": 1, "maximum": 256},
    "includes_intercept": {"type": "boolean"},
    "complete_data_degrees_of_freedom": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "design_fingerprint": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/fingerprint"}]
    },
    "source_fingerprints": {
      "type": "array", "minItems": 2, "maxItems": 1000,
      "items": {"$ref": "#/$defs/fingerprint"}
    }
  },
  "$defs": {
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "vector": {
      "type": "array", "minItems": 1, "maxItems": 257,
      "items": {"type": "number"}
    },
    "nonnegativeVector": {
      "type": "array", "minItems": 1, "maxItems": 257,
      "items": {"type": "number", "minimum": 0}
    },
    "positiveVector": {
      "type": "array", "minItems": 1, "maxItems": 257,
      "items": {"type": "number", "exclusiveMinimum": 0}
    },
    "probabilityVector": {
      "type": "array", "minItems": 1, "maxItems": 257,
      "items": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "matrix": {
      "type": "array", "minItems": 1, "maxItems": 257,
      "items": {"$ref": "#/$defs/vector"}
    }
  }
}
