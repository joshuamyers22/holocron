{
  "schema_version": "holocron-tolerance-policy/v1",
  "profiles": {
    "generalized-linear-v1": {
      "description": "Field-aware tolerances for supported Gaussian/identity and binomial/logit Glm fits.",
      "default": {"mode": "exact"},
      "rules": [
        {"path": "/design/*/*", "rule": {"mode": "numeric", "absolute": 1e-12, "relative": 1e-12}},
        {"path": "/coefficients/*", "rule": {"mode": "numeric", "absolute": 1e-8, "relative": 1e-7}},
        {"path": "/covariance/*/*", "rule": {"mode": "numeric", "absolute": 1e-7, "relative": 1e-6}},
        {"path": "/linear_predictors/*", "rule": {"mode": "numeric", "absolute": 1e-8, "relative": 1e-7}},
        {"path": "/deviance/*", "rule": {"mode": "numeric", "absolute": 1e-8, "relative": 1e-7}},
        {"path": "/response/*", "rule": {"mode": "numeric", "absolute": 0, "relative": 0}},
        {"path": "/fitted_mean/*", "rule": {"mode": "numeric", "absolute": 1e-8, "relative": 1e-7}}
      ]
    },
    "postfit-inference-v1": {
      "description": "Field-aware tolerances for covariance, likelihood, residual, prediction, coefficient summary, Wald ANOVA, and linear contrast operations.",
      "default": {"mode": "exact"},
      "rules": [
        {"path": "/covariance/*/*", "rule": {"mode": "numeric", "absolute": 1e-7, "relative": 1e-6}},
        {"path": "/likelihood/log_likelihood", "rule": {"mode": "numeric", "absolute": 1e-8, "relative": 1e-7}},
        {"path": "/likelihood/null_log_likelihood", "rule": {"mode": "numeric", "absolute": 1e-8, "relative": 1e-7}},
        {"path": "/likelihood/aic", "rule": {"mode": "numeric", "absolute": 1e-8, "relative": 1e-7}},
        {"path": "/likelihood/likelihood_ratio", "rule": {"mode": "numeric", "absolute": 1e-8, "relative": 1e-7}},
        {"path": "/likelihood/p_value", "rule": {"mode": "numeric", "absolute": 1e-8, "relative": 1e-7}},
        {"path": "/residuals/*/*", "rule": {"mode": "numeric", "absolute": 1e-8, "relative": 1e-7}},
        {"path": "/prediction/values/*", "rule": {"mode": "numeric", "absolute": 1e-8, "relative": 1e-7}},
        {"path": "/prediction/standard_errors/*", "rule": {"mode": "numeric", "absolute": 1e-8, "relative": 1e-7}},
        {"path": "/prediction/lower/*", "rule": {"mode": "numeric", "absolute": 1e-8, "relative": 1e-7}},
        {"path": "/prediction/upper/*", "rule": {"mode": "numeric", "absolute": 1e-8, "relative": 1e-7}},
        {"path": "/summary/*/estimate", "rule": {"mode": "numeric", "absolute": 1e-8, "relative": 1e-7}},
        {"path": "/summary/*/standard_error", "rule": {"mode": "numeric", "absolute": 1e-8, "relative": 1e-7}},
        {"path": "/summary/*/statistic", "rule": {"mode": "numeric", "absolute": 1e-8, "relative": 1e-7}},
        {"path": "/summary/*/p_value", "rule": {"mode": "numeric", "absolute": 1e-8, "relative": 1e-7}},
        {"path": "/summary/*/lower", "rule": {"mode": "numeric", "absolute": 1e-8, "relative": 1e-7}},
        {"path": "/summary/*/upper", "rule": {"mode": "numeric", "absolute": 1e-8, "relative": 1e-7}},
        {"path": "/anova/*/statistic", "rule": {"mode": "numeric", "absolute": 1e-8, "relative": 1e-7}},
        {"path": "/anova/*/p_value", "rule": {"mode": "numeric", "absolute": 1e-8, "relative": 1e-7}},
        {"path": "/contrast/estimate", "rule": {"mode": "numeric", "absolute": 1e-8, "relative": 1e-7}},
        {"path": "/contrast/standard_error", "rule": {"mode": "numeric", "absolute": 1e-8, "relative": 1e-7}},
        {"path": "/contrast/statistic", "rule": {"mode": "numeric", "absolute": 1e-8, "relative": 1e-7}},
        {"path": "/contrast/p_value", "rule": {"mode": "numeric", "absolute": 1e-8, "relative": 1e-7}},
        {"path": "/contrast/lower", "rule": {"mode": "numeric", "absolute": 1e-8, "relative": 1e-7}},
        {"path": "/contrast/upper", "rule": {"mode": "numeric", "absolute": 1e-8, "relative": 1e-7}}
      ]
    },
    "covariance-resampling-v1": {
      "description": "Field-aware tolerances for cluster-sandwich and declared-schedule bootstrap covariance.",
      "default": {"mode": "exact"},
      "rules": [
        {"path": "/robust/matrix/*/*", "rule": {"mode": "numeric", "absolute": 1e-7, "relative": 1e-6}},
        {"path": "/bootstrap/matrix/*/*", "rule": {"mode": "numeric", "absolute": 1e-7, "relative": 1e-6}},
        {"path": "/bootstrap/coefficient_mean/*", "rule": {"mode": "numeric", "absolute": 1e-8, "relative": 1e-7}}
      ]
    },
    "regularization-covariance-v1": {
      "description": "Field-aware tolerances for diagonal quadratic penalties, cluster-sandwich covariance, and declared-schedule bootstrap covariance.",
      "default": {"mode": "exact"},
      "rules": [
        {"path": "/penalized/coefficients/*", "rule": {"mode": "numeric", "absolute": 1e-8, "relative": 1e-7}},
        {"path": "/penalized/covariance/*/*", "rule": {"mode": "numeric", "absolute": 1e-7, "relative": 1e-6}},
        {"path": "/penalized/linear_predictors/*", "rule": {"mode": "numeric", "absolute": 1e-8, "relative": 1e-7}},
        {"path": "/penalized/fitted_values/*", "rule": {"mode": "numeric", "absolute": 1e-8, "relative": 1e-7}},
        {"path": "/penalized/residuals/*", "rule": {"mode": "numeric", "absolute": 1e-8, "relative": 1e-7}},
        {"path": "/penalized/penalty_weights/*", "rule": {"mode": "numeric", "absolute": 0, "relative": 0}},
        {"path": "/penalized/effective_degrees_of_freedom", "rule": {"mode": "numeric", "absolute": 1e-8, "relative": 1e-7}},
        {"path": "/penalized/residual_degrees_of_freedom", "rule": {"mode": "numeric", "absolute": 1e-8, "relative": 1e-7}},
        {"path": "/penalized/residual_scale", "rule": {"mode": "numeric", "absolute": 1e-8, "relative": 1e-7}},
        {"path": "/robust/matrix/*/*", "rule": {"mode": "numeric", "absolute": 1e-7, "relative": 1e-6}},
        {"path": "/bootstrap/matrix/*/*", "rule": {"mode": "numeric", "absolute": 1e-7, "relative": 1e-6}},
        {"path": "/bootstrap/coefficient_mean/*", "rule": {"mode": "numeric", "absolute": 1e-8, "relative": 1e-7}}
      ]
    }
  }
}
